# Copy to .env and fill in. Real values never get committed (.env is
# gitignored) -- this file exists so a fresh checkout knows what it needs.

# reddit_scraper.py -- a Reddit "script" app (old.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_SECRET=

# llm_summarizer.py -- OpenAI, for the digest summary itself
OPENAI_API_KEY=

# x_scraper.py -- twitterapi.io, a third-party X/Twitter API reseller
TWITTER_IO_API_KEY=

# send_notification.py -- who the digest mails from and to
EMAIL_FROM=
EMAIL_TO=

# shortlist_job.py / readwise_client.py -- readwise.io/access_token
READWISE_API_KEY=

# html_status/ -- optional. Unset = the status pages never render or write
# anything. Set to a directory a webserver serves and both jobs write a page
# there after every run. See the "status pages" section of README.md.
HTML_SERVE_DIR=/home/html
